<UserControl x:Class="CadenTool.Views.SideBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CadenTool.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <Button Content="我的博客" Command="{Binding NavigateCommand}" CommandParameter="CadenBase"/>
        <Button Content="生成博客" Command="{Binding NavigateCommand}" CommandParameter="CadenBaseGene"/>
        <Button Content="设置" Command="{Binding NavigateCommand}" CommandParameter="Setting"/>
    </StackPanel>
</UserControl>
